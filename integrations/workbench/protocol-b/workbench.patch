diff --git a/tests/protocol_b_loopback.rs b/tests/protocol_b_loopback.rs
new file mode 100644
--- /dev/null
+++ b/tests/protocol_b_loopback.rs
@@ -0,0 +1,33 @@
+use sentinel_rs::flow::http::{Client, RequestSpec, RetryPolicy};
+use std::io::{Read, Write};
+use std::net::TcpListener;
+
+fn serve(body: &'static str) -> (String, std::thread::JoinHandle<String>) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let thread = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        stream.set_read_timeout(Some(std::time::Duration::from_secs(5))).unwrap();
+        let mut buffer = [0; 4096];
+        let count = stream.read(&mut buffer).unwrap();
+        write!(stream, "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", body.len(), body).unwrap();
+        String::from_utf8_lossy(&buffer[..count]).to_string()
+    });
+    (url, thread)
+}
+
+#[tokio::test]
+async fn mailbox_stays_local_while_external_requests_use_proxy() {
+    let (mail, local) = serve("local-code");
+    let (proxy, upstream) = serve("proxied");
+    let policy = RetryPolicy { max_attempts: 1, ..Default::default() };
+    let client = Client::build_with_timeout("fixture", Some(&proxy), policy, None, 5).unwrap();
+    let code = client.execute(&RequestSpec::get("mailbox", format!("{mail}/code?key=fixture"))).await.unwrap();
+    assert_eq!(code.body, "local-code");
+    let external = client.execute(&RequestSpec::get("external", "http://example.invalid/".to_string())).await.unwrap();
+    assert_eq!(external.body, "proxied");
+    assert!(local.join().unwrap().contains("/code?key=fixture"));
+    let request = upstream.join().unwrap();
+    assert!(request.contains("example.invalid"));
+    assert!(!request.contains("key=fixture"));
+}
diff --git a/tests/protocol_b_device_archive.rs b/tests/protocol_b_device_archive.rs
new file mode 100644
--- /dev/null
+++ b/tests/protocol_b_device_archive.rs
@@ -0,0 +1,37 @@
+use sentinel_rs::flow::{store::Store, RegisterConfig};
+use sentinel_rs::fingerprint::DeviceFingerprint;
+
+#[test]
+fn snapshot_exports_the_existing_profile_without_generating_missing_fields() {
+    let mut cfg = RegisterConfig::default();
+    assert!(cfg.registration_device_snapshot("observed-device").is_none());
+    let fp = DeviceFingerprint::generate(Some("offline-archive-fixture"));
+    cfg.user_agent = fp.user_agent.clone();
+    cfg.accept_language = fp.lang_full.clone();
+    cfg.fingerprint = Some(fp.clone());
+    let snapshot = cfg.registration_device_snapshot("observed-device").unwrap();
+    assert_eq!(snapshot["device_id"], "observed-device");
+    assert_eq!(snapshot["fingerprint_ref"], fp.fingerprint_id);
+    let profile = &snapshot["browser_profile"];
+    assert_eq!(profile["chrome_full_version"], fp.browser_version);
+    assert_eq!(profile["browser_full_version"], fp.chrome_full_version);
+    assert_eq!(profile["hardware_concurrency"], fp.hardware_concurrency);
+    assert_eq!(profile["timezone_iana"], fp.timezone);
+    assert!(profile.get("js_heap_size_limit").is_none());
+    assert_eq!(cfg.fingerprint, Some(fp));
+
+    let path = std::env::temp_dir().join(format!("device-archive-{}.sqlite3", uuid::Uuid::new_v4()));
+    {
+        let store = Store::open(&path).unwrap();
+        store.init().unwrap();
+        store.init().unwrap();
+        store.save_registration_device("owner@example.test", &snapshot).unwrap();
+        store.save_registration_device("owner@example.test", &serde_json::json!({"device_id":"other"})).unwrap();
+    }
+    let con = rusqlite::Connection::open(&path).unwrap();
+    let saved: String = con.query_row("SELECT device_json FROM registration_devices WHERE email=?1",
+        ["owner@example.test"], |r| r.get(0)).unwrap();
+    assert_eq!(serde_json::from_str::<serde_json::Value>(&saved).unwrap(), snapshot);
+    drop(con);
+    std::fs::remove_file(path).unwrap();
+}
